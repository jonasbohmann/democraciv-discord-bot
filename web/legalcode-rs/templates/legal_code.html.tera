{% extends "base" %}

{% block title %}
Legal Code · Democraciv MK13
{% endblock title %}

{% block page_class %}page-wide{% endblock page_class %}

{% block content %}
<section class="page-header">
    <article class="page-header-card">
        <h1>Legal Code of the Celtic Nation</h1>
        <p>
            There are {{ total_count }} active law{% if total_count != 1 %}s{% endif %} or procedures in total.
        </p>

        <div style="margin-top: 1rem;">
            <div class="eyebrow">Index</div>
            <ul class="toc-list">
                {% for section in index_sections %}
                <li>
                    <a href="{{ section.href }}">Law #{{ section.id }} · {{ section.name }}</a>
                    {% if section.amendments | length > 0 %}
                    <ul class="toc-list">
                        {% for amendment in section.amendments %}
                        <li>
                            <span class="record-subtle">Amendment: </span>
                            <a href="{{ amendment.href }}">Law #{{ amendment.id }} · {{ amendment.name }}</a>
                        </li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </div>
    </article>
<!--     <article class="surface-panel toc-card">
        
    </article> -->
</section>

{% if sections | length == 0 %}
<article class="empty-state">
    <div class="eyebrow">Nothing Here Yet</div>
    <h2>No active laws are available.</h2>
    <p>This page will populate automatically once bills become active laws.</p>
</article>
{% else %}
<section class="stack">
    <div class="gdoc-font-toggle-row">
        {% if has_gdoc_html %}
        <button type="button" class="primary gdoc-font-toggle" data-gdoc-font-toggle>
            Use default font
        </button>
        {% endif %}
        <a href="/legal-code/pdf?timestamp={{ now(utc=true, timestamp=true) }}" role="button" class="primary gdoc-font-toggle">View Legal Code as PDF</a>
    </div>
    <section class="code-list" aria-label="Legal code">
    {% for section in sections %}
    <article class="code-entry" id="{{ section.anchor_id }}">
        <header>
            <small class="detail-meta">Law #{{ section.law.id }}</small>
            <h2>{{ section.law.name }}</h2>
            <p class="record-subtle">
                <a href="/law/{{ section.law.id }}">Show details</a>
                ·
                <a href="{{ section.law.link }}" target="_blank" rel="noopener noreferrer">Read on Google Docs</a>
            </p>

            {% if section.amends | length > 0 %}
            <div style="margin-top: 0.5rem;">
                <small class="detail-meta">Amends</small>
                <ul class="toc-list">
                    {% for amended_law in section.amends %}
                    <li>
                        <a href="{{ amended_law.href }}">Law #{{ amended_law.id }} · {{ amended_law.name }}</a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            {% if section.amendments | length > 0 %}
            <div style="margin-top: 0.5rem;">
                <small class="detail-meta">Amended By</small>
                <ul class="toc-list">
                    {% for amendment in section.amendments %}
                    <li>
                        <a href="{{ amendment.href }}">Law #{{ amendment.law.id }} · {{ amendment.law.name }}</a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}
        </header>

        <div class="{{ section.law.content_class }}">{{ section.law.content_html | safe }}</div>
    </article>
    {% endfor %}
    </section>
</section>
{% endif %}
{% endblock content %}
