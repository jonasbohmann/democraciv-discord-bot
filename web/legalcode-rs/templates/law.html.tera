{% extends "base" %}

{% block title %}
Law #{{ law.id }} · Democraciv MK13
{% endblock title %}

{% block content %}
<a href="/law" class="back-link">&larr; Back to laws</a>

<section class="stack">
    <article class="detail-card">
        <header>
            <small class="detail-meta">Law #{{ law.id }}</small>
            <h1>{{ law.name }}</h1>
        </header>

        <div style="display: flex; align-items: center; gap: 1rem; margin: 1.5rem 0;">
            <img
                src="{{ law.author.avatar_url }}"
                alt="{{ law.author.display_name }} avatar"
                style="width: 56px; height: 56px; border-radius: 999px; object-fit: cover;"
            >
            <div>
                <div class="detail-meta">Written by</div>
                <div>{{ law.author.display_name }}</div>
                <div class="record-subtle">@{{ law.author.username }}</div>
            </div>
        </div>

        <div class="badge-row">
            <span class="badge">⚖ Active law</span>
        </div>

        <dl class="detail-fields">
            <div class="field">
                <dt>Originated in Chamber</dt>
                <dd>{{ law.origin_house_label }}</dd>
            </div>
            <div class="field">
                <dt>Type</dt>
                <dd>{{ law.type_label }}</dd>
            </div>
            <div class="field">
                <dt>Link</dt>
                <dd><a href="{{ law.link }}" target="_blank" rel="noopener noreferrer">Google Docs</a></dd>
            </div>
            <div class="field">
                <dt>Summary</dt>
                <dd>{{ law.submitter_description }}</dd>
            </div>
        </dl>

        {% if law.amends | length > 0 or law.amended_by | length > 0 %}
        <section class="stack">
            <div>
                <h2 style="margin-top: 0;">Amendments</h2>
            </div>

            {% if law.amends | length > 0 %}
            <div class="record-meta">
                <span class="detail-meta">Amends</span>
                <ul class="toc-list">
                    {% for related in law.amends %}
                    <li>
                        <a href="{{ related.href }}">{{ related.kind_label }} #{{ related.id }} · {{ related.name }}</a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            {% if law.amended_by | length > 0 %}
            <div class="record-meta">
                <span class="detail-meta">Amended By</span>
                <ul class="toc-list">
                    {% for related in law.amended_by %}
                    <li>
                        <a href="{{ related.href }}">{{ related.kind_label }} #{{ related.id }} · {{ related.name }}</a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}
        </section>
        {% endif %}

        <div class="keyline" aria-hidden="true"></div>

        <section class="stack">
            {% if law.uses_gdoc_html %}
            <div class="gdoc-font-toggle-row">
                <button type="button" class="primary gdoc-font-toggle" data-gdoc-font-toggle>
                    Use default font
                </button>
            </div>
            {% endif %}
            <div class="{{ law.content_class }}" style="margin-top: 2rem;">{{ law.content_html | safe }}</div>
        </section>
    </article>
</section>
{% endblock content %}
